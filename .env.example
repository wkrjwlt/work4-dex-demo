# Next Public Environment Variables
# WETH address - Sepolia 测试网
# ⚠️ 重要：Sepolia 测试网使用不同的 WETH 地址！
# Sepolia WETH 地址: 0xfff9976782d46cc05630d1f6ebab18b2324d6b14
# 主网 WETH 地址（不适用于 Sepolia）: 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
NEXT_PUBLIC_WETH9_ADDRESS=0xfff9976782d46cc05630d1f6ebab18b2324d6b14

# WalletConnect Project ID (get from https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# Sepolia RPC URL (optional - if not set, will use public endpoints)
# Recommended: Get your own Infura/Alchemy key for better reliability
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# Or use Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY